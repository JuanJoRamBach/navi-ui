{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NAVI",
  "version": "0.3.1",
  "identifier": "online.getnavi.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8443",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NAVI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQUVFMjEwMEM3QzM2NEUKUldST05ud01FT0t1bjVzY2V0MXRTUWNhVFY2MnVJMGVZRGZTL0RURE9YLzlRRHo3Wmx6Mm1MNXQK",
      "endpoints": [
        "https://github.com/JuanJoRamBach/navi-ui/releases/latest/download/latest.json"
      ]
    }
  }
}
